import FastPoly.Section5.PerturbedT

/-!
# `lem:4k+1-splittable`: the crown construction

The `4k+1` pair is the shared `T_{k,4}` call over the explicit quadratic/quartic
tower `H₂ = (x+b)x + c`, `H₄ = H₂² - (x+a)² + e`, `H̃₄ = H₄ + ρ`.  The five outer
parameters decode from the top five rows with slopes `2k, 2k, -2k, k, k`
(`fourk_param_vis`), and the pair is compatible on the full window with no auxiliary
data (`fourk_crown_compatible`).  The generic engines `coeff_pow_window` and
`pow_coeff_crown` (top-window expansion of a monic power) live here.
-/

namespace FastPoly

open Polynomial Algebra

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- Windowed power coefficients: if the base's coefficients at indices `≥ c` lie in
`K`, then the `q`-th power's coefficients at indices `≥ (q-1)·D' + c` lie in `K`. -/
theorem coeff_pow_window {K : Subalgebra R A} {U : A[X]} {D' c : ℕ}
    (hUd : U.natDegree ≤ D') (hUK : ∀ a, c ≤ a → U.coeff a ∈ K) :
    ∀ q b, 1 ≤ q → (q - 1) * D' + c ≤ b → (U ^ q).coeff b ∈ K := by
  intro q
  induction q with
  | zero => omega
  | succ q ih =>
    intro b h1 hb
    rcases Nat.eq_zero_or_pos q with hq0 | hqpos
    · subst hq0
      rw [pow_one]
      exact hUK b (by omega)
    · have hqq : (q - 1) * D' + D' = q * D' := by
        have h1' : q - 1 + 1 = q := by omega
        calc (q - 1) * D' + D' = (q - 1 + 1) * D' := by ring
          _ = q * D' := by rw [h1']
      have hq1 : (q + 1 - 1) * D' = q * D' := by
        have h1' : q + 1 - 1 = q := by omega
        rw [h1']
      rw [pow_succ, coeff_mul]
      refine Subalgebra.sum_mem _ fun x hx => ?_
      have hxa : x.1 + x.2 = b := Finset.mem_antidiagonal.1 hx
      rcases Nat.lt_or_ge D' x.2 with hg2 | hl2
      · rw [show U.coeff x.2 = 0 from coeff_eq_zero_of_natDegree_lt (by omega),
          mul_zero]
        exact Subalgebra.zero_mem _
      · rcases Nat.lt_or_ge (q * D') x.1 with hg1 | hl1
        · rw [show (U ^ q).coeff x.1 = 0 from coeff_eq_zero_of_natDegree_lt (by
            have hd : (U ^ q).natDegree ≤ q * D' :=
              le_trans natDegree_pow_le (Nat.mul_le_mul_left _ hUd)
            omega), zero_mul]
          exact Subalgebra.zero_mem _
        · exact Subalgebra.mul_mem _ (ih x.1 hqpos (by omega))
            (hUK x.2 (by omega))

/-- **Crown expansion of a monic power** (the top-window pivot): the coefficient of
`H^n` at `n·D - t` is `n·H.coeff (D - t)` up to elements generated by the strictly
higher coefficients of `H`. -/
theorem pow_coeff_crown {S : Subalgebra R A} {H : A[X]} {D t : ℕ}
    (hH : H.Monic) (hD : H.natDegree = D) (h1 : 1 ≤ t) (htD : t ≤ D)
    (hS : ∀ j, D - t < j → H.coeff j ∈ S) :
    ∀ n, 1 ≤ n → (H ^ n).coeff (n * D - t)
      - ((n : ℕ) : A) * H.coeff (D - t) ∈ S := by
  intro n hn
  have hD1 : 1 ≤ D := by omega
  have hDn : D * n = n * D := Nat.mul_comm D n
  have hDn1 : D * (n - 1) + D = D * n := by
    have h1' : n - 1 + 1 = n := by omega
    calc D * (n - 1) + D = D * (n - 1 + 1) := by ring
      _ = D * n := by rw [h1']
  have hGd : (H - X ^ D).natDegree ≤ D - 1 := by
    have hcoeffz : ∀ m, D - 1 < m → (H - X ^ D).coeff m = 0 := by
      intro m hm
      rcases eq_or_lt_of_le (show D ≤ m from by omega) with heq | hlt
      · rw [coeff_sub, coeff_X_pow, if_pos heq.symm, ← heq, ← hD,
          hH.coeff_natDegree, sub_self]
      · rw [coeff_sub, coeff_X_pow, if_neg (by omega),
          coeff_eq_zero_of_natDegree_lt (by omega), sub_zero]
    exact natDegree_le_iff_coeff_eq_zero.2 (fun m hm => hcoeffz m (by omega))
  have hGS : ∀ a, D - t + 1 ≤ a → (H - X ^ D).coeff a ∈ S := by
    intro a ha
    rw [coeff_sub, coeff_X_pow]
    refine Subalgebra.sub_mem _ (hS a (by omega)) ?_
    split
    · exact Subalgebra.one_mem _
    · exact Subalgebra.zero_mem _
  have hHeq : H = X ^ D + (H - X ^ D) := by ring
  have hpow := pow_add_eq (X ^ D) (H - X ^ D) (m := n) hn
  have hXn : ((X : A[X]) ^ D) ^ n = X ^ (D * n) := by
    rw [← pow_mul]
  have hXn1 : ((X : A[X]) ^ D) ^ (n - 1) = X ^ (D * (n - 1)) := by
    rw [← pow_mul]
  have hkey : (H ^ n).coeff (n * D - t)
      = (X ^ (D * n) : A[X]).coeff (n * D - t)
        + n • ((H - X ^ D) * X ^ (D * (n - 1))).coeff (n * D - t)
        + (binTail (X ^ D) (H - X ^ D) n).coeff (n * D - t) := by
    conv_lhs => rw [hHeq]
    rw [hpow, hXn, hXn1, coeff_add, coeff_add, coeff_smul]
  have hXz : (X ^ (D * n) : A[X]).coeff (n * D - t) = 0 := by
    rw [coeff_X_pow, if_neg (by omega)]
  have hGX : ((H - X ^ D) * X ^ (D * (n - 1))).coeff (n * D - t)
      = (H - X ^ D).coeff (D - t) := by
    have hidx : n * D - t = (D - t) + D * (n - 1) := by
      have hnd : D * (n - 1) + D = D * n := by
        have h1' : n - 1 + 1 = n := by omega
        calc D * (n - 1) + D = D * (n - 1 + 1) := by ring
          _ = D * n := by rw [h1']
      omega
    rw [hidx, coeff_mul_X_pow]
  have hGpivot : (H - X ^ D).coeff (D - t) = H.coeff (D - t) := by
    rw [coeff_sub, coeff_X_pow, if_neg (by omega), sub_zero]
  have hbinS : (binTail (X ^ D) (H - X ^ D) n).coeff (n * D - t) ∈ S := by
    show (∑ q ∈ Finset.Icc 2 n,
      (H - X ^ D) ^ q * (X ^ D) ^ (n - q) * ((n.choose q : ℕ) : A[X])).coeff
        (n * D - t) ∈ S
    rw [finset_sum_coeff]
    refine Subalgebra.sum_mem _ fun q hq => ?_
    obtain ⟨hq2, hqn⟩ := Finset.mem_Icc.1 hq
    have hXq : ((X : A[X]) ^ D) ^ (n - q) = X ^ (D * (n - q)) := by
      rw [← pow_mul]
    rw [show ((n.choose q : ℕ) : A[X]) = C ((n.choose q : ℕ) : A) from by
        rw [Polynomial.C_eq_natCast],
      mul_comm ((H - X ^ D) ^ q * (X ^ D) ^ (n - q)) _, coeff_C_mul, hXq]
    refine Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ _) ?_
    rcases Nat.lt_or_ge (n * D - t) (D * (n - q)) with hlo | hge
    · -- below the monomial shift: the coefficient vanishes
      rw [coeff_mul]
      refine Subalgebra.sum_mem _ fun x hx => ?_
      have hxa : x.1 + x.2 = n * D - t := Finset.mem_antidiagonal.1 hx
      rw [coeff_X_pow]
      split
      · omega
      · rw [mul_zero]
        exact Subalgebra.zero_mem _
    · have hidx : n * D - t = (n * D - t - D * (n - q)) + D * (n - q) := by omega
      rw [hidx, coeff_mul_X_pow]
      refine coeff_pow_window hGd hGS q _ (by omega) ?_
      -- (q-1)(D-1) + (D-t+1) ≤ qD - t + (extra), where the target index is
      -- n·D - t - D(n-q) = q·D - t
      have hqd : n * D - t - D * (n - q) = q * D - t := by
        have hnq : D * (n - q) + q * D = n * D := by
          have h' : (n - q) + q = n := by omega
          calc D * (n - q) + q * D = D * ((n - q) + q) := by ring
            _ = D * n := by rw [h']
            _ = n * D := by ring
        omega
      rw [hqd]
      have hexp : (q - 1) * (D - 1) + (D - t + 1) ≤ q * D - t := by
        have h1' : q - 1 + 1 = q := by omega
        have hq1D : (q - 1) * (D - 1) + (D - 1) = q * (D - 1) := by
          calc (q - 1) * (D - 1) + (D - 1) = (q - 1 + 1) * (D - 1) := by ring
            _ = q * (D - 1) := by rw [h1']
        have hqDD : q * (D - 1) + q = q * D := by
          calc q * (D - 1) + q = q * ((D - 1) + 1) := by ring
            _ = q * D := by rw [show D - 1 + 1 = D from by omega]
        omega
      exact hexp
  have hfin : (H ^ n).coeff (n * D - t) - ((n : ℕ) : A) * H.coeff (D - t)
      = (binTail (X ^ D) (H - X ^ D) n).coeff (n * D - t) := by
    rw [hkey, hXz, hGX, hGpivot]
    simp only [nsmul_eq_mul]
    ring
  rw [hfin]
  exact hbinS


section fourK

variable [Nontrivial A] {b c a e ρ : A}

/-- The quadratic base of the `4k+1` construction. -/
noncomputable def crownH2 (b c : A) : A[X] := (X + C b) * X + C c

/-- The quartic power of the `4k+1` construction. -/
noncomputable def crownH4 (b c a e : A) : A[X] :=
  crownH2 b c ^ 2 - (X + C a) ^ 2 + C e

/-- The two-level tower of the `4k+1` construction. -/
noncomputable def crownHp (b c a e : A) : ℕ → A[X] :=
  fun i => if i = 1 then crownH2 b c else if i = 2 then crownH4 b c a e else X

omit [Nontrivial A] in
theorem crownHp_one : crownHp b c a e 1 = crownH2 b c := rfl

omit [Nontrivial A] in
theorem crownHp_two : crownHp b c a e 2 = crownH4 b c a e := rfl

omit [Nontrivial A] in
theorem crownH2_coeff_zero : (crownH2 b c).coeff 0 = c := by
  unfold crownH2
  rw [coeff_add, mul_coeff_zero, coeff_X_zero, mul_zero, coeff_C, if_pos rfl,
    zero_add]

omit [Nontrivial A] in
theorem crownH2_coeff_one : (crownH2 b c).coeff 1 = b := by
  unfold crownH2
  rw [coeff_add, mul_comm, coeff_X_mul, coeff_add, coeff_X_zero, coeff_C,
    if_pos rfl, coeff_C, if_neg (by omega), zero_add, add_zero]

omit [Nontrivial A] in
theorem crownH2_coeff_two : (crownH2 b c).coeff 2 = 1 := by
  unfold crownH2
  rw [coeff_add, mul_comm, coeff_X_mul, coeff_add, coeff_X_one, coeff_C,
    if_neg (by omega), coeff_C, if_neg (by omega), add_zero, add_zero]

theorem crownH2_monic : (crownH2 b c).Monic ∧ (crownH2 b c).natDegree = 2 := by
  have hm : ((X + C b) * X : A[X]).Monic := (monic_X_add_C b).mul monic_X
  have hd : ((X + C b) * X : A[X]).natDegree = 2 := by
    rw [(monic_X_add_C b).natDegree_mul monic_X, natDegree_X_add_C, natDegree_X]
  obtain ⟨hm', hd'⟩ := monic_add_low (e := C c) hm
    (Or.inr (by rw [natDegree_C, hd]; omega))
  exact ⟨hm', hd'.trans hd⟩

omit [Nontrivial A] in
/-- Normal form of the quartic. -/
theorem crownH4_eq : crownH4 b c a e
    = X ^ 4 + C (b + b) * X ^ 3 + C (b * b + (c + c) - 1) * X ^ 2
      + C (b * c + b * c - (a + a)) * X + C (c * c - a * a + e) := by
  unfold crownH4 crownH2
  simp only [map_add, map_mul, map_sub, map_one]
  ring

omit [Nontrivial A] in
theorem crownH4_coeff_three : (crownH4 b c a e).coeff 3 = b + b := by
  rw [crownH4_eq]
  simp only [coeff_add, coeff_C_mul, coeff_X_pow, Polynomial.coeff_X, coeff_C]
  norm_num

omit [Nontrivial A] in
theorem crownH4_coeff_two :
    (crownH4 b c a e).coeff 2 = b * b + (c + c) - 1 := by
  rw [crownH4_eq]
  simp only [coeff_add, coeff_C_mul, coeff_X_pow, Polynomial.coeff_X, coeff_C]
  norm_num

omit [Nontrivial A] in
theorem crownH4_coeff_one :
    (crownH4 b c a e).coeff 1 = b * c + b * c - (a + a) := by
  rw [crownH4_eq]
  simp only [coeff_add, coeff_C_mul, coeff_X_pow, Polynomial.coeff_X, coeff_C]
  norm_num

omit [Nontrivial A] in
theorem crownH4_coeff_zero :
    (crownH4 b c a e).coeff 0 = c * c - a * a + e := by
  rw [crownH4_eq]
  simp only [coeff_add, coeff_C_mul, coeff_X_pow, Polynomial.coeff_X, coeff_C]
  norm_num

theorem crownH4_monic : (crownH4 b c a e).Monic ∧ (crownH4 b c a e).natDegree = 4 := by
  rw [crownH4_eq]
  have hrest : (C (b + b) * X ^ 3 + C (b * b + (c + c) - 1) * X ^ 2
      + C (b * c + b * c - (a + a)) * X + C (c * c - a * a + e)).natDegree ≤ 3 := by
    refine le_trans (natDegree_add_le _ _) ?_
    simp only [natDegree_C, max_le_iff]
    refine ⟨le_trans (natDegree_add_le _ _) ?_, by omega⟩
    simp only [max_le_iff]
    refine ⟨le_trans (natDegree_add_le _ _) ?_, ?_⟩
    · simp only [max_le_iff]
      constructor
      · exact le_trans (natDegree_C_mul_le _ _) (by
          rw [natDegree_X_pow])
      · exact le_trans (natDegree_C_mul_le _ _) (by
          rw [natDegree_X_pow]
          omega)
    · exact le_trans (natDegree_C_mul_le _ _) (by
        rw [natDegree_X]
        omega)
  have hXm : ((X : A[X]) ^ 4).Monic := monic_X_pow 4
  have hXd : ((X : A[X]) ^ 4).natDegree = 4 := natDegree_X_pow 4
  have hassoc : (X ^ 4 + C (b + b) * X ^ 3 + C (b * b + (c + c) - 1) * X ^ 2
      + C (b * c + b * c - (a + a)) * X + C (c * c - a * a + e) : A[X])
      = X ^ 4 + (C (b + b) * X ^ 3 + C (b * b + (c + c) - 1) * X ^ 2
        + C (b * c + b * c - (a + a)) * X + C (c * c - a * a + e)) := by
    ring
  rw [hassoc]
  obtain ⟨hm', hd'⟩ := monic_add_low
    (e := C (b + b) * X ^ 3 + C (b * b + (c + c) - 1) * X ^ 2
      + C (b * c + b * c - (a + a)) * X + C (c * c - a * a + e)) hXm
    (Or.inr (by omega))
  exact ⟨hm', hd'.trans hXd⟩

/-- The shifted quartic is monic of degree 4. -/
theorem crownH4t_good (ρ : A) : (crownH4 b c a e + C ρ).Monic ∧
    (crownH4 b c a e + C ρ).natDegree = 4 := by
  obtain ⟨hm, hd⟩ := monic_add_C
    (crownH4_monic (b := b) (c := c) (a := a) (e := e)).1
    (by rw [(crownH4_monic (b := b) (c := c) (a := a) (e := e)).2]; norm_num) ρ
  exact ⟨hm, hd.trans (crownH4_monic (b := b) (c := c) (a := a) (e := e)).2⟩

/-- Goodness of the two-level crown tower. -/
theorem crownHp_good : ∀ i, 1 ≤ i → i ≤ 2 → ((crownHp b c a e) i).Monic ∧
    ((crownHp b c a e) i).natDegree = 2 ^ i := by
  intro i h1 hi
  rcases (show i = 1 ∨ i = 2 from by omega) with rfl | rfl
  · rw [crownHp_one]
    exact ⟨crownH2_monic.1, by rw [crownH2_monic.2]; norm_num⟩
  · rw [crownHp_two]
    exact ⟨crownH4_monic.1, by rw [crownH4_monic.2]; norm_num⟩

/-- The scalar-difference witness of the crown tower. -/
theorem crownHp_sd (ρ : A) :
    crownH4 b c a e + C ρ - crownHp b c a e 2 = C ρ := by
  rw [crownHp_two]
  ring

/-- The crown quadratic's coefficients lie in any subalgebra containing its data. -/
theorem crownH2_coeff_mem {S : Subalgebra R A} {b c : A} (hb : b ∈ S) (hc : c ∈ S) :
    ∀ j, (crownH2 b c).coeff j ∈ S := by
  intro j
  rcases j with _ | _ | _ | m
  · rw [crownH2_coeff_zero]; exact hc
  · rw [crownH2_coeff_one]; exact hb
  · rw [crownH2_coeff_two]; exact one_mem _
  · rw [coeff_eq_zero_of_natDegree_lt (by rw [(crownH2_monic (b := b) (c := c)).2]; omega)]
    exact zero_mem _

/-- The crown quartic's coefficients lie in any subalgebra containing its data. -/
theorem crownH4_coeff_mem {S : Subalgebra R A} {b c a e : A}
    (hb : b ∈ S) (hc : c ∈ S) (ha : a ∈ S) (he : e ∈ S) :
    ∀ j, (crownH4 b c a e).coeff j ∈ S := by
  intro j
  rcases j with _ | _ | _ | _ | _ | m
  · rw [crownH4_coeff_zero]
    exact add_mem (sub_mem (mul_mem hc hc) (mul_mem ha ha)) he
  · rw [crownH4_coeff_one]
    exact sub_mem (add_mem (mul_mem hb hc) (mul_mem hb hc)) (add_mem ha ha)
  · rw [crownH4_coeff_two]
    exact sub_mem (add_mem (mul_mem hb hb) (add_mem hc hc)) (one_mem _)
  · rw [crownH4_coeff_three]
    exact add_mem hb hb
  · have h4 : (crownH4 b c a e).coeff 4 = 1 := by
      rw [← (crownH4_monic (b := b) (c := c) (a := a) (e := e)).2]
      exact (crownH4_monic (b := b) (c := c) (a := a) (e := e)).1.coeff_natDegree
    show (crownH4 b c a e).coeff 4 ∈ S
    rw [h4]
    exact one_mem _
  · rw [coeff_eq_zero_of_natDegree_lt
      (by rw [(crownH4_monic (b := b) (c := c) (a := a) (e := e)).2]; omega)]
    exact zero_mem _

/-- Tower coefficient membership from the four crown data. -/
theorem crownHp_coeff_mem {S : Subalgebra R A} {b c a e : A}
    (hb : b ∈ S) (hc : c ∈ S) (ha : a ∈ S) (he : e ∈ S) :
    ∀ i, 1 ≤ i → i ≤ 2 → ∀ j, ((crownHp b c a e) i).coeff j ∈ S := by
  intro i h1 hi
  rcases (show i = 1 ∨ i = 2 from by omega) with rfl | rfl
  · rw [crownHp_one]
    exact crownH2_coeff_mem hb hc
  · rw [crownHp_two]
    exact crownH4_coeff_mem hb hc ha he

variable {K : Subalgebra R A} {k : ℕ} {α : ℕ → A}

/-- Recovery of the five crown parameters at their causal cutoffs. -/
theorem fourk_param_vis (hk : 1 ≤ k)
    (hadm : ∀ n : ℕ, 1 ≤ n → n ≤ 2 * k → IsUnit (((n : ℕ) : ℤ) : R))
    (b c a e ρ : A) :
    b ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k)
    ∧ c ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 1)
    ∧ a ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 2)
    ∧ e ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 3)
    ∧ ρ ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := by
  obtain ⟨hH2m, hH2d⟩ := crownH2_monic (A := A) (b := b) (c := c)
  obtain ⟨hH4m, hH4d⟩ := crownH4_monic (A := A) (b := b) (c := c) (a := a) (e := e)
  obtain ⟨hHtm, hHtd⟩ := crownH4t_good (b := b) (c := c) (a := a) (e := e) ρ
  have htower : ∀ i, 1 ≤ i → i ≤ 2 → ((crownHp b c a e) i).Monic ∧
      ((crownHp b c a e) i).natDegree = 2 ^ i := by
    intro i h1 hi
    rcases Nat.lt_or_ge i 2 with h | h
    · have hie : i = 1 := by omega
      subst hie
      rw [crownHp_one]
      exact ⟨hH2m, by rw [hH2d]; norm_num⟩
    · have hie : i = 2 := by omega
      subst hie
      rw [crownHp_two]
      exact ⟨hH4m, by rw [hH4d]; norm_num⟩
  obtain ⟨hsp₁, hsp₂⟩ := Tpair_eq_pow_add_R
    (Hp := crownHp b c a e) (Ht := crownH4 b c a e + C ρ) (k := k) (l := 2)
    (α := α)
  rw [show crownHp b c a e 2 = crownH4 b c a e from crownHp_two] at hsp₁
  obtain ⟨hRd₁, hRd₂⟩ := Rk2l_deg k (by omega) 2 (crownHp b c a e)
    (crownH4 b c a e + C ρ) α (by omega) htower hHtm hHtd
