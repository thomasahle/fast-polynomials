          · rcases Nat.lt_or_ge j 4 with h3' | h4'
            · rw [show j = 3 from by omega, crownH4_coeff_three]
              exact Subalgebra.add_mem _ hbV hbV
            · rw [show j = 4 from by omega, ← hH4d, hH4m.coeff_natDegree]
              exact Subalgebra.one_mem _
    have hcrown3' := pow_coeff_crown hH4m hH4d (t := 3) (by omega) (by omega)
      (fun j hj => hS3 j (by omega)) k hk
    have hcrown4 := pow_coeff_crown hH4m hH4d (t := 4) (by omega) (by omega)
      hS3 k hk
    rw [show k * 4 - 3 = 4 * k - 3 from by omega, crownH4_coeff_one] at hcrown3'
    rw [show k * 4 - 4 = 4 * k - 4 from by omega, crownH4_coeff_zero] at hcrown4
    have hAd : (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
        (4 * k - 4) ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 3) := by
      rcases eq_or_lt_of_le hk with hk1 | hk2
      · rw [← hk1, Rpair_one]
        rw [show ((0, 0) : A[X] × A[X]).1 = 0 from rfl, coeff_zero]
        exact Subalgebra.zero_mem _
      · obtain ⟨hRl₁, -⟩ := Rk2l_lead k (by omega) 2 (crownHp b c a e)
          (crownH4 b c a e + C ρ) α (by omega) htower hHtm hHtd
          (fun _ _ _ => ⟨ρ, crownHp_sd ρ⟩)
        rw [show (k - 1) * 2 ^ 2 = 4 * k - 4 from by
          have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
          rw [h2]
          omega] at hRl₁
        rw [hRl₁]
        exact Subalgebra.neg_mem _ (Subalgebra.natCast_mem _ _)
    have hUco : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
        (4 * k - 4) = (crownH4 b c a e ^ k).coeff (4 * k - 4)
          + (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
            (4 * k - 4) := by
      rw [hsp₁, coeff_add]
    have hrowG : 4 * k - 3 ∈ Finset.range (4 * k + 1) := Finset.mem_range.2 (by omega)
    have hΨmem := coeff_mem_Vis (K := K)
      (Φ := combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      hrowG le_rfl
    have hcO : (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2).coeff (4 * k - 3)
        = (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
            (4 * k - 4)
          + (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2.coeff
            (4 * k - 3) := by
      rw [show 4 * k - 3 = (4 * k - 4) + 1 from by omega, coeff_combined,
        show (4 * k - 4) + 1 = 4 * k - 3 from by omega]
    obtain ⟨u, hu⟩ := hadm k (by omega) (by omega)
    have hMA : algebraMap R A (↑u : R) = ((k : ℕ) : A) := by
      rw [hu, map_intCast, Int.cast_natCast]
    have hke : ((k : ℕ) : A) * e ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 3) := by
      have hkey : ((k : ℕ) : A) * e
          = (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
              (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2).coeff
              (4 * k - 3)
            - (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
              (4 * k - 4)
            - ((crownH4 b c a e ^ k).coeff (4 * k - 4)
              - ((k : ℕ) : A) * (c * c - a * a + e))
            - ((crownH4 b c a e ^ k).coeff (4 * k - 3)
              - ((k : ℕ) : A) * (b * c + b * c - (a + a)))
            - ((k : ℕ) : A) * (b * c + b * c - (a + a))
            - ((k : ℕ) : A) * (c * c) + ((k : ℕ) : A) * (a * a) := by
        rw [hcO, hUco, hVco _ (by omega)]
        ring
      rw [hkey]
      exact Subalgebra.add_mem _ (Subalgebra.sub_mem _ (Subalgebra.sub_mem _
        (Subalgebra.sub_mem _ (Subalgebra.sub_mem _ (Subalgebra.sub_mem _
          hΨmem hAd) hcrown4) hcrown3')
        (Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ _)
          (Subalgebra.sub_mem _ (Subalgebra.add_mem _
            (Subalgebra.mul_mem _ hbV hcV) (Subalgebra.mul_mem _ hbV hcV))
            (Subalgebra.add_mem _ haV haV))))
        (Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ _)
          (Subalgebra.mul_mem _ hcV hcV)))
        (Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ _)
          (Subalgebra.mul_mem _ haV haV))
    have hkey2 : e = algebraMap R A (↑u⁻¹ : R) * (((k : ℕ) : A) * e) := by
      rw [← hMA, ← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
    have hfin := Subalgebra.mul_mem _
      (algebraMap_mem_Vis (K := K) (↑u⁻¹ : R)) hke
    rw [← hkey2] at hfin
    exact hfin
  have hρ : ρ ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := by
    have hbV : b ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 4) := Vis_antitone_cutoff (by omega) hb
    have hcV : c ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 4) := Vis_antitone_cutoff (by omega) hc
    have haV : a ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 4) := Vis_antitone_cutoff (by omega) ha
    have heV : e ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 4) := Vis_antitone_cutoff (by omega) he
    have hH4V : ∀ j, (crownH4 b c a e).coeff j ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 4) := by
      intro j
      rcases Nat.eq_zero_or_pos j with hj0 | hjpos
      · subst hj0
        rw [crownH4_coeff_zero]
        exact Subalgebra.add_mem _ (Subalgebra.sub_mem _
          (Subalgebra.mul_mem _ hcV hcV) (Subalgebra.mul_mem _ haV haV)) heV
      · rcases Nat.lt_or_ge 4 j with h4 | h4
        · rw [coeff_eq_zero_of_natDegree_lt (by omega)]
          exact Subalgebra.zero_mem _
        · rcases Nat.lt_or_ge j 2 with h2 | h2
          · rw [show j = 1 from by omega, crownH4_coeff_one]
            exact Subalgebra.sub_mem _ (Subalgebra.add_mem _
              (Subalgebra.mul_mem _ hbV hcV) (Subalgebra.mul_mem _ hbV hcV))
              (Subalgebra.add_mem _ haV haV)
          · rcases Nat.lt_or_ge j 3 with h3 | h3
            · rw [show j = 2 from by omega, crownH4_coeff_two]
              exact Subalgebra.sub_mem _ (Subalgebra.add_mem _
                (Subalgebra.mul_mem _ hbV hbV)
                (Subalgebra.add_mem _ hcV hcV)) (Subalgebra.one_mem _)
            · rcases Nat.lt_or_ge j 4 with h3' | h4'
              · rw [show j = 3 from by omega, crownH4_coeff_three]
                exact Subalgebra.add_mem _ hbV hbV
              · rw [show j = 4 from by omega, ← hH4d, hH4m.coeff_natDegree]
                exact Subalgebra.one_mem _
    have hH4kV : ∀ m, (crownH4 b c a e ^ k).coeff m ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 4) :=
      coeff_mem_pow hH4V k
    obtain ⟨u, hu⟩ := hadm k (by omega) (by omega)
    have hMA : algebraMap R A (↑u : R) = ((k : ℕ) : A) := by
      rw [hu, map_intCast, Int.cast_natCast]
    have hlead : (crownH4 b c a e ^ (k - 1)).coeff (4 * (k - 1)) = 1 := by
      have h := (hH4m.pow (k - 1)).coeff_natDegree
      rw [hH4m.natDegree_pow, hH4d, show (k - 1) * 4 = 4 * (k - 1) from by ring]
        at h
      exact h
    have hkρ : ((k : ℕ) : A) * ρ ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (4 * k - 4) := by
      rcases eq_or_lt_of_le hk with hk1 | hk2
      · -- `k = 1`: the bottom row reads `ρ` directly
        have hk1' : k = 1 := hk1.symm
        subst hk1'
        have hrowG : 0 ∈ Finset.range (4 * 1 + 1) := Finset.mem_range.2 (by omega)
        have hΨmem := coeff_mem_Vis (K := K) (t := 4 * 1 - 4)
          (Φ := combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
            1 2 α).1
            (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) 1 2 α).2)
          hrowG (by omega)
        have hkey : ((1 : ℕ) : A) * ρ
            = (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
                1 2 α).1
                (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) 1 2 α).2).coeff 0
              - (crownH4 b c a e ^ 1).coeff 0 := by
          rw [coeff_combined_zero, hsp₂, coeff_add,
            show (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) 1 2 α).2 = 0
              from by rw [Rpair_one], coeff_zero, add_zero, pow_one, pow_one,
            coeff_add, coeff_C]
          norm_num
        rw [hkey]
        exact Subalgebra.sub_mem _ hΨmem (hH4kV 0)
      · -- `k ≥ 2`: the boundary row with the parameter-free corrections
        obtain ⟨-, hRs₁, -, -⟩ := Rk2l_top_two
          (K := Vis R K
            (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
              (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
            (Finset.range (4 * k + 1)) (4 * k - 4))
          (α := α) hk2 (by omega) htower hHtm hHtd
          (fun _ _ _ => ⟨ρ, crownHp_sd ρ⟩)
          (by
            rw [show (2 : ℕ) ^ (2 - 1) - 1 = 1 from by norm_num,
              show crownHp b c a e (2 - 1) = crownH2 b c from rfl,
              crownH2_coeff_one]
            exact hbV)
          (by
            rw [show (2 : ℕ) ^ 2 - 1 = 3 from by norm_num, crownHp_two,
              crownH4_coeff_three]
            exact Subalgebra.add_mem _ hbV hbV)
          (by
            rw [show (2 : ℕ) ^ 2 - 1 = 3 from by norm_num, coeff_add,
              crownH4_coeff_three, coeff_C, if_neg (by omega)]
            exact Subalgebra.add_mem _ (Subalgebra.add_mem _ hbV hbV)
              (Subalgebra.zero_mem _))
        rw [show (k - 1) * 2 ^ 2 - 1 = 4 * k - 5 from by
          have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
          rw [h2]
          omega] at hRs₁
        obtain ⟨-, hRl₂⟩ := Rk2l_lead k (by omega) 2 (crownHp b c a e)
          (crownH4 b c a e + C ρ) α (by omega) htower hHtm hHtd
          (fun _ _ _ => ⟨ρ, crownHp_sd ρ⟩)
        rw [show (k - 1) * 2 ^ 2 = 4 * k - 4 from by
          have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
          rw [h2]
          omega] at hRl₂
        have hrowG : 4 * k - 4 ∈ Finset.range (4 * k + 1) :=
          Finset.mem_range.2 (by omega)
        have hΨmem := coeff_mem_Vis (K := K)
          (Φ := combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
            k 2 α).1
            (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
          hrowG le_rfl
        have hcO : (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
            k 2 α).1
            (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2).coeff
            (4 * k - 4)
            = (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
                (4 * k - 5)
              + (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2.coeff
                (4 * k - 4) := by
          rw [show 4 * k - 4 = (4 * k - 5) + 1 from by omega, coeff_combined,
            show (4 * k - 5) + 1 = 4 * k - 4 from by omega]
        have hUco : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
            k 2 α).1.coeff (4 * k - 5)
            = (crownH4 b c a e ^ k).coeff (4 * k - 5)
              + (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
                (4 * k - 5) := by
          rw [hsp₁, coeff_add]
        have hVco' : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
            k 2 α).2.coeff (4 * k - 4)
            = (crownH4 b c a e ^ k).coeff (4 * k - 4) + ((k : ℕ) : A) * ρ
              + (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2.coeff
                (4 * k - 4) := by
          rw [hsp₂, coeff_add, htpow, coeff_add, coeff_add, coeff_smul,
            htbinz _ (by omega), add_zero, coeff_C_mul,
            show 4 * k - 4 = 4 * (k - 1) from by omega, hlead, mul_one]
          simp only [nsmul_eq_mul]
        have hkey : ((k : ℕ) : A) * ρ
            = (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
                k 2 α).1
                (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2).coeff
                (4 * k - 4)
              - (crownH4 b c a e ^ k).coeff (4 * k - 5)
              - (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
                (4 * k - 5)
              - (crownH4 b c a e ^ k).coeff (4 * k - 4)
              - (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2.coeff
                (4 * k - 4) := by
          rw [hcO, hUco, hVco']
          ring
        rw [hkey, hRl₂]
        exact Subalgebra.sub_mem _ (Subalgebra.sub_mem _ (Subalgebra.sub_mem _
          (Subalgebra.sub_mem _ hΨmem (hH4kV _)) hRs₁) (hH4kV _))
          (Subalgebra.neg_mem _ (Subalgebra.natCast_mem _ _))
    have hkey2 : ρ = algebraMap R A (↑u⁻¹ : R) * (((k : ℕ) : A) * ρ) := by
      rw [← hMA, ← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
    have hfin := Subalgebra.mul_mem _
      (algebraMap_mem_Vis (K := K) (↑u⁻¹ : R)) hkρ
    rw [← hkey2] at hfin
    exact hfin
  exact ⟨hb, hc, ha, he, hρ⟩

/-- **`lem:4k+1-splittable`, compatibility core**: the crown pair is a compatible
pair of degree `4k` on the full window, with no auxiliary data. -/
theorem fourk_crown_compatible (hk : 1 ≤ k)
    (hadm : ∀ n : ℕ, 1 ≤ n → n ≤ 2 * k → IsUnit (((n : ℕ) : ℤ) : R))
    (b c a e ρ : A) (α : ℕ → A) :
    CompatiblePair K
      (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
      (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2
      (4 * k) (Finset.range (4 * k + 1)) := by
  obtain ⟨hb, hc, ha, he, hρ⟩ := fourk_param_vis (K := K) (α := α) hk hadm b c a e ρ
  obtain ⟨hH2m, hH2d⟩ := crownH2_monic (A := A) (b := b) (c := c)
  obtain ⟨hH4m, hH4d⟩ := crownH4_monic (A := A) (b := b) (c := c) (a := a) (e := e)
  obtain ⟨hHtm, hHtd⟩ := crownH4t_good (b := b) (c := c) (a := a) (e := e) ρ
  have htower : ∀ i, 1 ≤ i → i ≤ 2 → ((crownHp b c a e) i).Monic ∧
      ((crownHp b c a e) i).natDegree = 2 ^ i := by
    intro i h1 hi
    rcases Nat.lt_or_ge i 2 with h | h
    · have hie : i = 1 := by omega
      subst hie
      rw [crownHp_one]
      exact ⟨hH2m, by rw [hH2d]; norm_num⟩
    · have hie : i = 2 := by omega
      subst hie
      rw [crownHp_two]
      exact ⟨hH4m, by rw [hH4d]; norm_num⟩
  obtain ⟨hsp₁, hsp₂⟩ := Tpair_eq_pow_add_R
    (Hp := crownHp b c a e) (Ht := crownH4 b c a e + C ρ) (k := k) (l := 2)
    (α := α)
  rw [show crownHp b c a e 2 = crownH4 b c a e from crownHp_two] at hsp₁
  obtain ⟨hRd₁, hRd₂⟩ := Rk2l_deg k (by omega) 2 (crownHp b c a e)
    (crownH4 b c a e + C ρ) α (by omega) htower hHtm hHtd
    (fun _ _ _ => ⟨ρ, crownHp_sd ρ⟩)
  obtain ⟨⟨hTm₁, hTd₁⟩, hTm₂, hTd₂⟩ := Tpair_good
    (Hp := crownHp b c a e) (Ht := crownH4 b c a e + C ρ) (α := α)
    (k := k) (l := 2) (by omega) (by omega) (fun _ _ => by omega) htower hHtm hHtd
  have hTd₁' : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.natDegree
      = 4 * k := by
    rw [hTd₁]
    ring
  have hTd₂' : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2.natDegree
      = 4 * k := by
    rw [hTd₂]
    ring
  -- everything lives in the boundary context
  have hbV : b ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := Vis_antitone_cutoff (by omega) hb
  have hcV : c ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := Vis_antitone_cutoff (by omega) hc
  have haV : a ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := Vis_antitone_cutoff (by omega) ha
  have heV : e ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := Vis_antitone_cutoff (by omega) he
  have hH2V : ∀ j, (crownH2 b c).coeff j ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := by
    intro j
    rcases Nat.eq_zero_or_pos j with hj0 | hjpos
    · subst hj0
      rw [crownH2_coeff_zero]
      exact hcV
    · rcases Nat.lt_or_ge j 2 with h2 | h2
      · rw [show j = 1 from by omega, crownH2_coeff_one]
        exact hbV
      · rcases Nat.lt_or_ge 2 j with h2' | h2''
        · rw [coeff_eq_zero_of_natDegree_lt (by omega)]
          exact Subalgebra.zero_mem _
        · rw [show j = 2 from by omega, crownH2_coeff_two]
          exact Subalgebra.one_mem _
  have hH4V : ∀ j, (crownH4 b c a e).coeff j ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := by
    intro j
    rcases Nat.eq_zero_or_pos j with hj0 | hjpos
    · subst hj0
      rw [crownH4_coeff_zero]
      exact Subalgebra.add_mem _ (Subalgebra.sub_mem _
        (Subalgebra.mul_mem _ hcV hcV) (Subalgebra.mul_mem _ haV haV)) heV
    · rcases Nat.lt_or_ge 4 j with h4 | h4
      · rw [coeff_eq_zero_of_natDegree_lt (by omega)]
        exact Subalgebra.zero_mem _
      · rcases Nat.lt_or_ge j 2 with h2 | h2
        · rw [show j = 1 from by omega, crownH4_coeff_one]
          exact Subalgebra.sub_mem _ (Subalgebra.add_mem _
            (Subalgebra.mul_mem _ hbV hcV) (Subalgebra.mul_mem _ hbV hcV))
            (Subalgebra.add_mem _ haV haV)
        · rcases Nat.lt_or_ge j 3 with h3 | h3
          · rw [show j = 2 from by omega, crownH4_coeff_two]
            exact Subalgebra.sub_mem _ (Subalgebra.add_mem _
              (Subalgebra.mul_mem _ hbV hbV)
              (Subalgebra.add_mem _ hcV hcV)) (Subalgebra.one_mem _)
          · rcases Nat.lt_or_ge j 4 with h3' | h4'
            · rw [show j = 3 from by omega, crownH4_coeff_three]
              exact Subalgebra.add_mem _ hbV hbV
            · rw [show j = 4 from by omega, ← hH4d, hH4m.coeff_natDegree]
              exact Subalgebra.one_mem _
  have hHtV : ∀ j, (crownH4 b c a e + C ρ).coeff j ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4) := by
    intro j
    rw [coeff_add, coeff_C]
    refine Subalgebra.add_mem _ (hH4V j) ?_
    split
    · exact hρ
    · exact Subalgebra.zero_mem _
  have htowerVd : ∀ i, 1 ≤ i → i ≤ 2 → ((crownHp b c a e) i).Monic ∧
      ((crownHp b c a e) i).natDegree = 2 ^ i ∧
      (∀ j, ((crownHp b c a e) i).coeff j ∈ Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4)) := by
    intro i h1 hi
    obtain ⟨hm, hd⟩ := htower i h1 hi
    refine ⟨hm, hd, ?_⟩
    rcases Nat.lt_or_ge i 2 with h | h
    · have hie : i = 1 := by omega
      subst hie
      rw [crownHp_one]
      exact hH2V
    · have hie : i = 2 := by omega
      subst hie
      rw [crownHp_two]
      exact hH4V
  have hcert := Rk2l_triangular k (by omega) 2 (crownHp b c a e)
    (crownH4 b c a e + C ρ) α
    (Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4))
    (by omega) htowerVd hHtm hHtd hHtV
    (fun _ _ _ => ⟨ρ, crownHp_sd ρ⟩)
    (fun n h1 h2 => hadm n h1 (by omega))
  have hcompatVd := hcert.toCompatiblePair
    (N := 4 * k)
    (by
      intro j
      have hdiff : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
            k 2 α).1.coeff j
          - (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff j
          = (crownH4 b c a e ^ k).coeff j := by
        show _ - ((Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
            - (crownHp b c a e) 2 ^ k).coeff j = _
        rw [coeff_sub, show crownHp b c a e 2 = crownH4 b c a e from crownHp_two]
        ring
      rw [hdiff]
      exact coeff_mem_pow hH4V k j)
    (by
      intro j
      have hdiff : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
            k 2 α).2.coeff j
          - (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2.coeff j
          = ((crownH4 b c a e + C ρ) ^ k).coeff j := by
        show _ - ((Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2
            - (crownH4 b c a e + C ρ) ^ k).coeff j = _
        rw [coeff_sub]
        ring
      rw [hdiff]
      exact coeff_mem_pow hHtV k j)
    hTm₁ hTd₁' hTm₂ hTd₂'
    (by
      have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
      have h := Nat.mul_le_mul_right (2 ^ 2) (show k - 1 ≤ k from by omega)
      omega)
  -- upgrade to the honest context and window
  have hVdle : ∀ t, t ≤ 4 * k - 4 →
      Vis R (Vis R K
      (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
        (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
      (Finset.range (4 * k + 1)) (4 * k - 4))
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range ((k - 1) * 2 ^ 2)) t
      ≤ Vis R K
          (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
            (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
          (Finset.range (4 * k + 1)) t := by
    intro t ht
    refine Vis_le ?_ ?_
    · exact Vis_antitone_cutoff ht
    · intro i hi hti
      refine coeff_mem_Vis ?_ hti
      refine Finset.mem_range.2 ?_
      have h := Finset.mem_range.1 hi
      have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
      omega
  -- the crown rows of the powers, with their causal cutoffs
  have hH4kfine : ∀ j, 4 * k - 4 ≤ j → (crownH4 b c a e ^ k).coeff j
      ∈ Vis R K
        (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1
          (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
        (Finset.range (4 * k + 1)) (j + 1) := by
    intro j hj
    rcases Nat.lt_or_ge (4 * k) j with hhi | hle
    · rw [coeff_eq_zero_of_natDegree_lt (by
        rw [hH4m.natDegree_pow, hH4d]
        omega)]
      exact Subalgebra.zero_mem _
    · rcases eq_or_lt_of_le hle with heq | hlt
      · rw [heq, show 4 * k = k * 4 from by ring, ← show (crownH4 b c a e ^ k).natDegree
            = k * 4 from by rw [hH4m.natDegree_pow, hH4d],
          (hH4m.pow k).coeff_natDegree]
        exact Subalgebra.one_mem _
      · -- j = 4k - t for t ∈ {1,2,3,4}
        set t := 4 * k - j with hts
        have ht14 : 1 ≤ t ∧ t ≤ 4 := by omega
        have hjt : j = 4 * k - t := by omega
        have hSfin : ∀ i, 4 - t < i → (crownH4 b c a e).coeff i
            ∈ Vis R K
              (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
                k 2 α).1
                (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
              (Finset.range (4 * k + 1)) (j + 1) := by
          intro i hi
          rcases Nat.lt_or_ge 4 i with h4 | h4
          · rw [coeff_eq_zero_of_natDegree_lt (by omega)]
            exact Subalgebra.zero_mem _
          · rcases Nat.lt_or_ge i 1 with h0 | h1
            · omega
            · rcases Nat.lt_or_ge i 2 with h2 | h2
              · rw [show i = 1 from by omega, crownH4_coeff_one]
                have hbi : b ∈ _ := Vis_antitone_cutoff
                  (show j + 1 ≤ 4 * k from by omega) hb
                have hci : c ∈ _ := Vis_antitone_cutoff
                  (show j + 1 ≤ 4 * k - 1 from by omega) hc
                have hai : a ∈ _ := Vis_antitone_cutoff
                  (show j + 1 ≤ 4 * k - 2 from by omega) ha
                exact Subalgebra.sub_mem _ (Subalgebra.add_mem _
                  (Subalgebra.mul_mem _ hbi hci) (Subalgebra.mul_mem _ hbi hci))
                  (Subalgebra.add_mem _ hai hai)
              · rcases Nat.lt_or_ge i 3 with h3 | h3
                · rw [show i = 2 from by omega, crownH4_coeff_two]
                  have hbi : b ∈ _ := Vis_antitone_cutoff
                    (show j + 1 ≤ 4 * k from by omega) hb
                  have hci : c ∈ _ := Vis_antitone_cutoff
                    (show j + 1 ≤ 4 * k - 1 from by omega) hc
                  exact Subalgebra.sub_mem _ (Subalgebra.add_mem _
                    (Subalgebra.mul_mem _ hbi hbi)
                    (Subalgebra.add_mem _ hci hci)) (Subalgebra.one_mem _)
                · rcases Nat.lt_or_ge i 4 with h3' | h4'
                  · rw [show i = 3 from by omega, crownH4_coeff_three]
                    have hbi : b ∈ _ := Vis_antitone_cutoff
                      (show j + 1 ≤ 4 * k from by omega) hb
                    exact Subalgebra.add_mem _ hbi hbi
                  · rw [show i = 4 from by omega, ← hH4d, hH4m.coeff_natDegree]
                    exact Subalgebra.one_mem _
        have hcrown := pow_coeff_crown hH4m hH4d (t := t)
          (by omega) (by omega) hSfin k hk
        rw [show k * 4 - t = j from by omega] at hcrown
        have hpiv : (crownH4 b c a e).coeff (4 - t)
            ∈ Vis R K
              (combined (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
                k 2 α).1
                (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).2)
              (Finset.range (4 * k + 1)) (j + 1) := by
          rcases Nat.lt_or_ge (4 - t) 1 with h0 | h1
          · rw [show 4 - t = 0 from by omega, crownH4_coeff_zero]
            have hci : c ∈ _ := Vis_antitone_cutoff
              (show j + 1 ≤ 4 * k - 1 from by omega) hc
            have hai : a ∈ _ := Vis_antitone_cutoff
              (show j + 1 ≤ 4 * k - 2 from by omega) ha
            have hei : e ∈ _ := Vis_antitone_cutoff
              (show j + 1 ≤ 4 * k - 3 from by omega) he
            exact Subalgebra.add_mem _ (Subalgebra.sub_mem _
              (Subalgebra.mul_mem _ hci hci) (Subalgebra.mul_mem _ hai hai)) hei
          · rcases Nat.lt_or_ge (4 - t) 2 with h2 | h2
            · rw [show 4 - t = 1 from by omega, crownH4_coeff_one]
              have hbi : b ∈ _ := Vis_antitone_cutoff
                (show j + 1 ≤ 4 * k from by omega) hb
              have hci : c ∈ _ := Vis_antitone_cutoff
                (show j + 1 ≤ 4 * k - 1 from by omega) hc
              have hai : a ∈ _ := Vis_antitone_cutoff
                (show j + 1 ≤ 4 * k - 2 from by omega) ha
              exact Subalgebra.sub_mem _ (Subalgebra.add_mem _
                (Subalgebra.mul_mem _ hbi hci) (Subalgebra.mul_mem _ hbi hci))
                (Subalgebra.add_mem _ hai hai)
            · rcases Nat.lt_or_ge (4 - t) 3 with h3 | h3
              · rw [show 4 - t = 2 from by omega, crownH4_coeff_two]
                have hbi : b ∈ _ := Vis_antitone_cutoff
                  (show j + 1 ≤ 4 * k from by omega) hb
                have hci : c ∈ _ := Vis_antitone_cutoff
                  (show j + 1 ≤ 4 * k - 1 from by omega) hc
                exact Subalgebra.sub_mem _ (Subalgebra.add_mem _
                  (Subalgebra.mul_mem _ hbi hbi)
                  (Subalgebra.add_mem _ hci hci)) (Subalgebra.one_mem _)
              · rw [show 4 - t = 3 from by omega, crownH4_coeff_three]
                have hbi : b ∈ _ := Vis_antitone_cutoff
                  (show j + 1 ≤ 4 * k from by omega) hb
                exact Subalgebra.add_mem _ hbi hbi
        have hrecomb : (crownH4 b c a e ^ k).coeff j
            = ((crownH4 b c a e ^ k).coeff j
                - ((k : ℕ) : A) * (crownH4 b c a e).coeff (4 - t))
              + ((k : ℕ) : A) * (crownH4 b c a e).coeff (4 - t) := by
          ring
        rw [hrecomb]
        exact Subalgebra.add_mem _ hcrown
          (Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ _) hpiv)
  -- the tilde-power boundary reads
  have htpow := pow_add_eq (crownH4 b c a e) (C ρ) (m := k) hk
  have htbinz : ∀ m, (k - 2) * 4 < m →
      (binTail (crownH4 b c a e) (C ρ) k).coeff m = 0 := by
    intro m hm
    refine coeff_eq_zero_of_natDegree_lt ?_
    have hbt := natDegree_binTail_le (le_of_eq hH4d)
      (le_of_eq (natDegree_C ρ)) (by omega) k
    omega
  refine
    { mem₁ := ?_
      mem₂ := ?_
      monic₁ := hTm₁
      monic₂ := hTm₂
      natDegree₁ := hTd₁'
      natDegree₂ := hTd₂'
      window := ?_ }
  · intro j
    rcases Nat.lt_or_ge j (4 * k - 4) with hjlt | hjge
    · have h := hcompatVd.mem₁ j
      refine hVdle (j + 1) (by omega) ?_
      have hconv : (k - 1) * 2 ^ 2 = 4 * k - 4 := by
        have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
        rw [h2]
        omega
      rw [hconv] at h ⊢
      exact h
    · have hTco : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
          k 2 α).1.coeff j
          = (crownH4 b c a e ^ k).coeff j
            + (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ) k 2 α).1.coeff
              j := by
        rw [hsp₁, coeff_add]
      rw [hTco]
      refine Subalgebra.add_mem _ (hH4kfine j hjge) ?_
      rcases eq_or_lt_of_le hjge with heq | hlt
      · rcases eq_or_lt_of_le hk with hk1 | hk2
        · rw [← hk1, Rpair_one]
          rw [show ((0, 0) : A[X] × A[X]).1 = 0 from rfl, coeff_zero]
          exact Subalgebra.zero_mem _
        · obtain ⟨hRl₁, -⟩ := Rk2l_lead k (by omega) 2 (crownHp b c a e)
            (crownH4 b c a e + C ρ) α (by omega) htower hHtm hHtd
            (fun _ _ _ => ⟨ρ, crownHp_sd ρ⟩)
          rw [show (k - 1) * 2 ^ 2 = 4 * k - 4 from by
            have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
            rw [h2]
            omega] at hRl₁
          rw [← heq, hRl₁]
          exact Subalgebra.neg_mem _ (Subalgebra.natCast_mem _ _)
      · rw [coeff_eq_zero_of_natDegree_lt (by
          have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
          omega)]
        exact Subalgebra.zero_mem _
  · intro j
    rcases Nat.lt_or_ge j (4 * k - 4) with hjlt | hjge
    · have h := hcompatVd.mem₂ j
      refine hVdle j (by omega) ?_
      have hconv : (k - 1) * 2 ^ 2 = 4 * k - 4 := by
        have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
        rw [h2]
        omega
      rw [hconv] at h ⊢
      exact h
    · rcases eq_or_lt_of_le hjge with heq | hlt
      · have h := hcompatVd.mem₂ j
        refine hVdle j (by omega) ?_
        have hconv : (k - 1) * 2 ^ 2 = 4 * k - 4 := by
          have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
          rw [h2]
          omega
        rw [hconv] at h ⊢
        exact h
      · have hTco : (Tpair (crownHp b c a e) (crownH4 b c a e + C ρ)
            k 2 α).2.coeff j = (crownH4 b c a e ^ k).coeff j := by
          rw [hsp₂, coeff_add, htpow, coeff_add, coeff_add, coeff_smul,
            htbinz _ (by omega), add_zero,
            show (C ρ * crownH4 b c a e ^ (k - 1)).coeff j = 0 from by
              rw [coeff_C_mul,
                show (crownH4 b c a e ^ (k - 1)).coeff j = 0 from
                  coeff_eq_zero_of_natDegree_lt (by
                    rw [hH4m.natDegree_pow, hH4d]
                    omega), mul_zero],
            smul_zero, add_zero,
            show (Rpair (crownHp b c a e) (crownH4 b c a e + C ρ)
                k 2 α).2.coeff j = 0 from coeff_eq_zero_of_natDegree_lt (by
              have h2 : (2 : ℕ) ^ 2 = 4 := by norm_num
              omega),
            add_zero]
        rw [hTco]
        exact Vis_antitone_cutoff (by omega) (hH4kfine j hjge)
  · intro x hx
    exact hx

end fourK

