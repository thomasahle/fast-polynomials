  apply bounded_ext (d := 15)
  · exact (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (le_trans (normal_w_degree (extendFin q)) (by omega)) (le_trans (normal_s_degree (extendFin q)) (by omega))) (le_trans (normal_r_degree (extendFin q)) (by omega))) (by simp only [natDegree_C]; omega))
  · exact (natDegree_add_le_of_degree_le (le_trans (natDegree_X_pow_le _) (by omega)) (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (natDegree_add_le_of_degree_le (by simp only [natDegree_zero]; omega) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))) (le_trans (natDegree_C_mul_X_pow_le _ _) (by omega))))
  · intro k hk
    interval_cases k <;>
