        coeff_add, coeff_C_mul_X_pow, coeff_X_pow, coeff_C, coeff_zero,
        ite_true, ite_false, zero_add, add_zero, zero_mul, mul_zero, one_mul, mul_one] <;>
      (try simp only [offsets, offset_14, tail, tail_0, tail_1, tail_2, tail_3, tail_4, tail_5, tail_6, tail_7, tail_8, tail_9, tail_10, tail_11, tail_12, tail_13, tail_14, pivot, Equiv.refl_apply, row_w_0, row_w_1, row_w_2, row_w_3, row_w_4, row_w_5, row_w_6, row_w_7, row_w_8, row_w_9, row_w_10, row_s_0, row_s_1, row_s_2, row_s_3, row_s_4, row_s_5, row_s_6, row_s_7, row_s_8, row_s_9, row_s_10, row_r_0, row_r_1, row_r_2, row_r_3, row_r_4, row_r_5, row_r_6, row_r_7, row_r_8, row_r_9, row_r_10, row_r_11, row_r_12, row_r_13, row_r_14]) <;>
      ring_char2

theorem evaluation_bijective (x : Fin 15 → F) (hx : Function.Injective x) :
    Function.Bijective (fun q => fun i => (family q).eval (x i)) :=
  Char2Certificate.evaluation_bijective (by omega) _ tail tail_causal rows family family_normal x hx

/-- Preprocessed gate offsets for any requested monic polynomial. -/
noncomputable def decode (c : Fin 15 → F) : ℕ → F := offsets (extendFin (coefficients.symm c))

theorem decode_correct (c : Fin 15 → F) :
    polynomial (decode c) = monicOfCoefficients c := by
  have h := family_normal (coefficients.symm c)
  simpa only [family, decode, Equiv.apply_symm_apply] using h

/-- The same literal counted circuit realizes every prescribed coefficient vector. -/
theorem program_decode_correct (c : Fin 15 → F) :
    (program (F := F)).circuit.eval
      (fun i => if i = 0 then X else C (decode c (i-1))) 0 = monicOfCoefficients c :=
  (program_eval (decode c)).trans (decode_correct c)

